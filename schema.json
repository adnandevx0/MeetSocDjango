components:
  schemas:
    AccountSuspension:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        user:
          type: string
          format: uuid
        reason:
          type: string
        starts_at:
          type: string
          format: date-time
        ends_at:
          type: string
          format: date-time
          nullable: true
        is_permanent:
          type: boolean
        status:
          $ref: '#/components/schemas/AccountSuspensionStatusEnum'
        created_by:
          type: string
          format: uuid
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - created_by
      - id
      - updated_at
      - user
    AccountSuspensionRequest:
      type: object
      properties:
        user:
          type: string
          format: uuid
        reason:
          type: string
        starts_at:
          type: string
          format: date-time
        ends_at:
          type: string
          format: date-time
          nullable: true
        is_permanent:
          type: boolean
        status:
          $ref: '#/components/schemas/AccountSuspensionStatusEnum'
      required:
      - user
    AccountSuspensionStatusEnum:
      enum:
      - active
      - lifted
      - expired
      type: string
      description: |-
        * `active` - Active
        * `lifted` - Lifted
        * `expired` - Expired
    BlueVerificationRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/BlueVerificationStatusEnum'
          readOnly: true
        note:
          type: string
        admin_note:
          type: string
          readOnly: true
        approved_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        valid_from:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        valid_until:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        is_active_badge:
          type: boolean
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - admin_note
      - approved_at
      - created_at
      - id
      - is_active_badge
      - status
      - updated_at
      - valid_from
      - valid_until
    BlueVerificationRequestRequest:
      type: object
      properties:
        note:
          type: string
    BlueVerificationStatusEnum:
      enum:
      - pending
      - approved
      - rejected
      - expired
      - cancelled
      type: string
      description: |-
        * `pending` - Pending
        * `approved` - Approved
        * `rejected` - Rejected
        * `expired` - Expired
        * `cancelled` - Cancelled
    Call:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        call_type:
          $ref: '#/components/schemas/CallTypeEnum'
        caller:
          allOf:
          - $ref: '#/components/schemas/UserPublicLite'
          readOnly: true
        conversation:
          type: string
          format: uuid
        status:
          $ref: '#/components/schemas/CallStatusEnum'
        started_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        ended_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        duration:
          type: integer
          readOnly: true
          nullable: true
        call_participants:
          type: array
          items:
            $ref: '#/components/schemas/CallParticipant'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - call_participants
      - caller
      - conversation
      - created_at
      - duration
      - ended_at
      - id
      - started_at
    CallParticipant:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        user:
          allOf:
          - $ref: '#/components/schemas/UserPublicLite'
          readOnly: true
        joined_at:
          type: string
          format: date-time
          nullable: true
        left_at:
          type: string
          format: date-time
          nullable: true
        is_muted:
          type: boolean
        is_video_on:
          type: boolean
      required:
      - id
      - user
    CallParticipantRequest:
      type: object
      properties:
        joined_at:
          type: string
          format: date-time
          nullable: true
        left_at:
          type: string
          format: date-time
          nullable: true
        is_muted:
          type: boolean
        is_video_on:
          type: boolean
    CallRequest:
      type: object
      properties:
        call_type:
          $ref: '#/components/schemas/CallTypeEnum'
        conversation:
          type: string
          format: uuid
        status:
          $ref: '#/components/schemas/CallStatusEnum'
      required:
      - conversation
    CallStatusEnum:
      enum:
      - ringing
      - active
