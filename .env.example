# Core
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Development: True = SQLite + in-memory cache/channels (no Docker). False = PostgreSQL + Redis from below.
USE_SQLITE=True

# Database (PostgreSQL 15+)
DB_NAME=meetsoc
DB_USER=meetsoc_user
DB_PASSWORD=meetsoc
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis 7+
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# CORS (Flutter / web clients)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MeetSoc <noreply@meetsoc.com>

# Media storage: local | s3 | cloudinary
# For Backblaze B2 use STORAGE_BACKEND=s3 with S3 compatible fields below.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth
GOOGLE_OAUTH2_KEY=
GOOGLE_OAUTH2_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# FCM push
FCM_SERVER_KEY=

# WebRTC TURN (optional)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Production TLS
SECURE_SSL_REDIRECT=True
